      "id": "slack",
      "name": "Send radar to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Collect what every stage reported, so the alert can say what actually broke\n// rather than just that something did.\nconst stages = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (!j.stage) continue;\n  stages.push({\n    stage: j.stage,\n    status: j.status || (j.ok ? 'ok' : 'failed'),\n    ok: j.ok !== false,\n    seconds: j.duration_seconds,\n    counts: j.counts || {},\n    failures: j.failures || [],\n    error: j.error || '',\n  });\n}\nconst broken = stages.filter(s => !s.ok || s.status === 'failed');\nconst partial = stages.filter(s => s.status === 'partial');\nconst lines = [];\nfor (const s of broken) lines.push(`FAILED  ${s.stage}: ${s.error || 'see run log'}`);\nfor (const s of partial) {\n  for (const f of s.failures.slice(0, 3)) {\n    lines.push(`partial ${s.stage} -> ${f.scope}:${f.item} ${String(f.error).slice(0, 90)}`);\n  }\n}\nreturn [{ json: {\n  healthy: broken.length === 0,\n  broken: broken.length,\n  partial: partial.length,\n  stages,\n  alert_text: lines.length\n    ? `Competitor Viral Radar had problems this morning:\\n${lines.join('\\n')}`\n    : '',\n}}];"
      },
      "id": "summarise",
      "name": "Build run summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.healthy }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check",
      "name": "Anything broken?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SLACK_BOT_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "channel",
              "value": "={{ $env.SLACK_CHANNEL }}"
            },
            {
              "name": "text",
              "value": "={{ $json.alert_text }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "alert",
      "name": "Failure alert to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1720,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ok: true, note: 'clean run' } }];"
      },
      "id": "clean",
      "name": "Clean run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1720,
        400
      ]
    }
  ],
