{
  "name": "Competitor ads \u2014 daily",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "45 6 * * *"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "6:45am New York",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -2200,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "base",
              "name": "baseUrl",
              "value": "https://REPLACE-ME.example.com",
              "type": "string"
            }
          ]
        }
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1980,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl }}/run/collect_meta_ads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "collect",
      "name": "Collect competitor ads",
      "credentials": {
        "httpCustomAuth": {
          "name": "CI service token"
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1760,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
