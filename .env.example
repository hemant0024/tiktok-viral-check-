# ---------- storage ----------
# local | sheets | memory
CI_STORAGE_BACKEND=local
CI_LOCAL_DATA_DIR=./data
# Google Sheets (CI_STORAGE_BACKEND=sheets)
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json
# "Competitor Viral Radar - daily", in your Drive.
# Share it with the service account email as EDITOR or every write returns 403.
# The pipeline creates these tabs on first push:
#   UGC_TODAY          replaced each morning, what is hot now
#   UGC_HISTORY        accumulates, every row of every day, never overwritten
#   ADS_TODAY          replaced each morning
#   ADS_HISTORY        accumulates
#   DAILY_BRIEF        Claude's written read, one row per day per flow
#   VIDEO_TRENDS       day over day movement per video
#   COMPETITOR_TRENDS  day over day movement per competitor
#   HASHTAG_TRENDS     which tags are rising
#   RUN_LOG            what ran, what failed
GOOGLE_SHEET_ID=1mioM_FQSkLYjMX6X9wzbfM_Lo2W81lU1LN_Db06M4mg

# ---------- LLM ----------
# openai | gemini | fake
CI_LLM_PROVIDER=openai
CI_LLM_CHEAP_MODEL=gpt-5.6-luna
CI_LLM_STRONG_MODEL=gpt-5.6-sol
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Gemini is used only for video understanding on public YouTube URLs
CI_VIDEO_PROVIDER=none
CI_VIDEO_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# ---------- sources ----------
YOUTUBE_API_KEY=
APIFY_TOKEN=

# ---------- notifications ----------
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#creative-radar
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- ops ----------
# Shared secret between n8n and the ci service. Leave blank for local use;
# set it if the ci port is ever reachable from outside the compose network,
# because these endpoints can trigger real spend.
CI_API_TOKEN=
CI_TIMEZONE=America/New_York
CI_LOG_LEVEL=INFO
CI_DRY_RUN=false

# ---------- public deployment (deploy/docker-compose.public.yml) ----------
# Only needed when n8n is NOT on the same machine, e.g. n8n Cloud.
# CI_API_TOKEN above is REQUIRED here: without it the service rejects every
# caller that is not on a private address, which is the safe default but means
# a public deployment answers nothing.
CI_DOMAIN=
CI_ACME_EMAIL=
